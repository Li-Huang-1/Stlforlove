<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="org.example.myblog.mapper.ArticleMapper">

    <!-- 文章详情列表(含 content) -->
    <select id="queryArticleListDetail" resultType="org.example.myblog.domain.vo.ArticleListDetailVO">
        SELECT id, title, content, type, create_time, status, category, cover_url
        FROM articles
        <where>
            <if test="query.includeDraft == null or query.includeDraft == false">
                status = 1
            </if>
            <if test="query.type != null and query.type != ''">
                AND type = #{query.type}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 文章简略列表(不含 content) -->
    <select id="queryArticleList" resultType="org.example.myblog.domain.vo.ArticleListVO">
        SELECT id, title, type, create_time, status, category, cover_url
        FROM articles
        <where>
            <if test="query.includeDraft == null or query.includeDraft == false">
                status = 1
            </if>
            <if test="query.type != null and query.type != ''">
                AND type = #{query.type}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

</mapper>
